{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA Player",
  "version": "1.11.0",
  "identifier": "com.nova.player",
  "build": {
    "beforeDevCommand": "node scripts/build.mjs",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NOVA Player",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "media-src": "'self' blob: data: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://itunes.apple.com https://rss.applemarketingtools.com https://api.github.com https://suggestqueries.google.com https://api.audius.co https://*.audius.co https://archive.org https://*.archive.org https://api.deezer.com",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Offline Persian music player",
    "longDescription": "NOVA is an offline Windows music player with playlists, lyrics, a 10-band equalizer, crossfade, a sleep timer, cover art and a native mini player.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "mp3"
        ],
        "name": "MP3 Audio",
        "description": "MP3 Audio · NOVA Player",
        "role": "Viewer",
        "mimeType": "audio/mpeg"
      },
      {
        "ext": [
          "m4a"
        ],
        "name": "MPEG-4 Audio",
        "description": "MPEG-4 Audio · NOVA Player",
        "role": "Viewer",
        "mimeType": "audio/mp4"
      },
      {
        "ext": [
          "flac"
        ],
        "name": "FLAC Audio",
        "description": "FLAC Audio · NOVA Player",
        "role": "Viewer",
        "mimeType": "audio/flac"
      },
      {
        "ext": [
          "ogg"
        ],
        "name": "Ogg Audio",
        "description": "Ogg Audio · NOVA Player",
        "role": "Viewer",
        "mimeType": "audio/ogg"
      },
      {
        "ext": [
          "opus"
        ],
        "name": "Opus Audio",
        "description": "Opus Audio · NOVA Player",
        "role": "Viewer",
        "mimeType": "audio/opus"
      },
      {
        "ext": [
          "wav"
        ],
        "name": "WAVE Audio",
        "description": "WAVE Audio · NOVA Player",
        "role": "Viewer",
        "mimeType": "audio/wav"
      }
    ]
  }
}