{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NOVA Player",
  "version": "1.9.0",
  "identifier": "com.nova.player",
  "build": {
    "beforeDevCommand": "node scripts/build.mjs",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NOVA Player",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Offline Persian music player",
    "longDescription": "NOVA is an offline Windows music player with playlists, lyrics, a 10-band equalizer, cover art and a native mini player.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
